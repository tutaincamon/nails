# ============================================================================
#  Copia este archivo como .env.local y rellena lo que necesites.
#  TODO es opcional: sin nada configurado la web funciona en modo prototipo
#  (base de datos en un archivo, emails simulados y pago simulado).
# ============================================================================

# --- URL pública ------------------------------------------------------------
# Necesaria para que los enlaces de los emails funcionen fuera de tu ordenador.
# En Vercel se rellena sola; en local déjalo así.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Panel de la profesional (/admin) ---------------------------------------
# Sin esto se usa la contraseña de ejemplo "demo1234". Cámbiala antes de publicar.
ADMIN_PASSWORD=

# ============================================================================
#  BASE DE DATOS
# ============================================================================
# Sin nada puesto: archivo local en data/studio.db. Perfecto para desarrollo.
#
# En hosting serverless (Vercel, Netlify) el disco es efímero y un archivo se
# perdería en cada despliegue, así que ahí hace falta Turso, que es SQLite en
# la nube y usa exactamente el mismo SQL. Plan gratuito en turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Carpeta de la base de datos y los emails simulados (solo en modo archivo).
DATA_DIR=

# ============================================================================
#  EMAILS
# ============================================================================
# Se elige el primer modo que esté configurado. Sin ninguno: modo simulado,
# los correos no salen a internet y se leen en /admin -> pestaña Emails.

# --- Opción A: SMTP (la más rápida, no necesita dominio propio) --------------
# Con Gmail: activa la verificación en dos pasos en tu cuenta de Google y crea
# una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# Esa contraseña va aquí (o en las variables de entorno del hosting), nunca en
# el código ni en el repositorio.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Con Gmail tiene que ser tu propia dirección, o se reescribe.
MAIL_FROM=

# --- Opción B: Resend (mejor a largo plazo, necesita dominio verificado) -----
RESEND_API_KEY=

# ============================================================================
#  COBRO DE LA SEÑAL (opcional)
# ============================================================================
# Con una clave de test (sk_test_...) se cobra con tarjetas de prueba y no se
# mueve dinero real. Si se deja vacío, se usa el pago simulado.
STRIPE_SECRET_KEY=
# Opcional pero recomendable en producción: confirma la reserva aunque la
# clienta cierre el navegador justo después de pagar.
STRIPE_WEBHOOK_SECRET=

# ============================================================================
#  RECORDATORIOS AUTOMÁTICOS
# ============================================================================
# Secreto que protege /api/cron/reminders para poder llamarlo desde un cron.
CRON_SECRET=
